  m_TableData:
  - m_Id: 71378256064512
    m_Localized: "The forest needs our help! \nAre you ready to start?"
    m_Metadata:
      m_Items: []
  - m_Id: 72137014046720
    m_Localized: "Let's see your forest\n in 20 years."
    m_Metadata:
      m_Items: []
  - m_Id: 72538249555968
    m_Localized: "Thank you! \nYou have cared for the forest for two years. You are
      helping to restore biodiversity to this area."
    m_Metadata:
      m_Items: []
  - m_Id: 72691542978560
    m_Localized: Please remove the headset and pass it to the next player.
    m_Metadata:
      m_Items: []
  - m_Id: 73113229914112
    m_Localized: "We\u2019ve planted 3,100 seedlings of 30 different species per
      hectare. "
    m_Metadata:
      m_Items: []
  - m_Id: 73172948414464
    m_Localized: "Now, it\u2019s time to protect them!\nAre you ready?"
    m_Metadata:
      m_Items: []
  - m_Id: 396351280820224
    m_Localized: Help friends plant a variety of seedlings and fertilize them for
      faster growth.
    m_Metadata:
      m_Items: []
  - m_Id: 396830811402240
    m_Localized: Begin
    m_Metadata:
      m_Items: []
  - m_Id: 20725188770983936
    m_Localized: EN
    m_Metadata:
      m_Items: []
  - m_Id: 20725224053469184
    m_Localized: "/\u0E44\u0E17\u0E22"
    m_Metadata:
      m_Items: []
  - m_Id: 87374202572173312
    m_Localized: Ready
    m_Metadata:
